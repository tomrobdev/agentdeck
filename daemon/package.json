{
  "name": "agentdeck-daemon",
  "version": "0.1.0",
  "private": true,
  "description": "AgentDeck daemon: task queue, scheduler and Claude Code workers",
  "type": "module",
  "bin": {
    "agentdeck": "bin/agentdeck.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/cli.ts daemon",
    "dev": "node --watch-path=src src/cli.ts daemon",
    "typecheck": "tsc",
    "test": "AGENTDECK_NO_NOTIFY=1 node --test test/",
    "test:watch": "AGENTDECK_NO_NOTIFY=1 node --test --watch test/"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
