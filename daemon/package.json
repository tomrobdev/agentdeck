{
  "name": "agentdeck-daemon",
  "version": "0.1.0",
  "private": true,
  "description": "AgentDeck daemon: task queue, scheduler and Claude Code workers",
  "type": "module",
  "bin": {
    "agentdeck": "bin/agentdeck.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/cli.ts daemon",
    "dev": "node --watch-path=src src/cli.ts daemon",
    "typecheck": "tsc",
    "test": "AGENTDECK_NO_NOTIFY=1 node --test test/",
    "test:crash": "node scripts/crash-test.mjs",
    "test:watch": "AGENTDECK_NO_NOTIFY=1 node --test --watch test/",
    "db:studio": "drizzle-kit studio",
    "db:check": "node scripts/db-check.ts",
    "docs": "node scripts/docs.ts",
    "db:generate": "node scripts/db-generate.ts"
  },
  "dependencies": {
    "drizzle-orm": "1.0.0-rc.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "drizzle-kit": "1.0.0-rc.5",
    "typescript": "^5.9.0"
  }
}
