{
  "name": "agentdeck-daemon",
  "version": "0.1.0",
  "private": true,
  "description": "AgentDeck daemon: task queue, scheduler and Claude Code workers",
  "type": "module",
  "bin": {
    "agentdeck": "bin/agentdeck.js"
  },
  "exports": {
    "./domain/*": "./src/domain/*",
    "./api/contract/*": "./src/api/contract/*"
  },
  "imports": {
    "#domain/*": "./src/domain/*",
    "#application/*": "./src/application/*",
    "#db/*": "./src/db/*",
    "#adapters/*": "./src/adapters/*",
    "#api/*": "./src/api/*",
    "#cli/*": "./src/cli/*",
    "#src/*": "./src/*",
    "#test/*": "./test/*",
    "#scripts/*": "./scripts/*",
    "#app/*": "agentdeck/app/*"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/cli.ts daemon",
    "dev": "node --watch-path=src src/cli.ts daemon",
    "typecheck": "tsc",
    "test": "AGENTDECK_NO_NOTIFY=1 AGENTDECK_CANCEL_POLL_MS=50 node --test --test-timeout=60000 test/",
    "test:crash": "node scripts/crash-test.mjs",
    "coverage": "node scripts/coverage.ts",
    "test:watch": "AGENTDECK_NO_NOTIFY=1 AGENTDECK_CANCEL_POLL_MS=50 node --test --test-timeout=60000 --watch test/",
    "db:studio": "drizzle-kit studio",
    "db:check": "node scripts/db-check.ts",
    "docs:gen": "node scripts/docs.ts",
    "rules": "node scripts/rules.ts",
    "db:generate": "node scripts/db-generate.ts",
    "imports:fix": "node scripts/absolute-imports.ts"
  },
  "dependencies": {
    "drizzle-orm": "1.0.0-rc.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "agentdeck": "workspace:*",
    "c8": "^12.0.0",
    "drizzle-kit": "1.0.0-rc.5",
    "typescript": "^5.9.0"
  }
}
