{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"$AGENTDECK_TASK_ID$AGENTDECK_PLANNER\" ] && command -v agentdeck >/dev/null && agentdeck context --hook || true",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"$AGENTDECK_TASK_ID$AGENTDECK_PLANNER\" ] && command -v agentdeck >/dev/null && agentdeck context --hook || true",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/edit-hook.mjs\"",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
