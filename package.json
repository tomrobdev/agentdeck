{
  "name": "agentdeck",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "scripts/dev.sh",
    "dev:daemon": "pnpm --filter agentdeck-daemon dev",
    "dev:app": "pnpm --filter agentdeck-app tauri:dev",
    "build": "pnpm --filter agentdeck-app tauri:build",
    "test": "pnpm --filter agentdeck-daemon test",
    "typecheck": "pnpm -r typecheck",
    "check:rust": "pnpm --filter agentdeck-app check:rust",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
