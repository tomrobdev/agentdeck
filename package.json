{
  "name": "agentdeck",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "scripts/dev.sh",
    "dev:daemon": "pnpm --filter agentdeck-daemon dev",
    "dev:app": "pnpm --filter agentdeck-app tauri:dev",
    "reboot": "agentdeck restart",
    "logs": "agentdeck logs -f",
    "setup:cli": "mkdir -p ~/.local/bin && ln -sf \"$PWD/daemon/bin/agentdeck.js\" ~/.local/bin/agentdeck && echo \"linked $(command -v agentdeck)\"",
    "build": "pnpm --filter agentdeck-app tauri:build",
    "test": "pnpm --filter agentdeck-daemon test",
    "test:crash": "pnpm --filter agentdeck-daemon test:crash",
    "coverage": "pnpm --filter agentdeck-daemon coverage",
    "typecheck": "pnpm -r typecheck",
    "db:studio": "pnpm --filter agentdeck-daemon db:studio",
    "db:check": "pnpm --filter agentdeck-daemon db:check",
    "docs:gen": "pnpm --filter agentdeck-daemon docs:gen",
    "rules": "pnpm --filter agentdeck-daemon rules",
    "db:generate": "pnpm --filter agentdeck-daemon db:generate",
    "check:rust": "cd app/src-tauri && cargo fmt --check && cargo clippy --offline --all-targets -- -D warnings && cargo test --offline",
    "check:rust:changed": "if git diff --quiet origin/main -- app/src-tauri; then echo 'nothing to check: app/src-tauri is unchanged from origin/main'; else pnpm check:rust; fi",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:fast": "pnpm format:check && pnpm typecheck && pnpm db:check && pnpm test",
    "check": "pnpm check:fast && node daemon/scripts/crash-test.mjs \"${CRASH_ITERATIONS:-10}\"",
    "check:stack": "node scripts/check-stack.mjs"
  },
  "devDependencies": {
    "prettier": "3.9.10"
  }
}
